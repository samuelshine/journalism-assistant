# Copy to .env and fill in what you have. Every value below is optional —
# the app runs fully without any of them; each just unlocks one extra tool.

# --- Ollama (defaults assume a local install, no change needed) ---
OLLAMA_HOST=http://localhost:11434
MODEL_REASONING=qwen2.5:14b
MODEL_LONGCTX=mistral-nemo:12b
MODEL_FAST=gemma4:e4b
MODEL_EMBED=nomic-embed-text

# --- Optional free-tier keys (register at the linked pages) ---
# Guardian Open Platform — free, instant: https://open-platform.theguardian.com/access/
# Set this and the Researcher, Scout, and Fact-Checker gain a real
# guardian_search tool — one well-edited paper's archive alongside GDELT's
# broader sweep. Everything else works identically without it.
GUARDIAN_API_KEY=
# The three below are reserved for future tools — nothing in the app reads
# them yet, so setting them right now has no effect.
# data.gov.in — free, instant: https://data.gov.in/user/register
DATA_GOV_IN_KEY=
# NewsAPI dev tier — free, instant: https://newsapi.org/register
NEWSAPI_KEY=
# YouTube Data API — free, needs a Google Cloud project: https://console.cloud.google.com/
YOUTUBE_API_KEY=

# --- App behaviour ---
DEMO_MODE=0
MAX_AGENT_ITERATIONS=8
MAX_TOOL_CALLS_PER_RUN=12
